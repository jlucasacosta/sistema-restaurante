# .env.example · SOLO nombres de variables, siempre vacias.
# El demo NO las usa: es frontend con datos de ejemplo.
# Se completan en TU copia cuando conectes el backend (ver docs/IMPLEMENTAR.md).
# Copialo asi:  cp .env.example .env.local   y completa .env.local (ese archivo NO se sube a git).

# ---- Supabase (base de datos + Auth) ----
# Project Settings > API. Estas dos viajan al navegador: son publicas por diseno.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETA. Se saltea la seguridad de la base (RLS).
# Solo para el script de carga y el worker de Railway. JAMAS con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Railway: worker con pg-boss (etapa 4) ----
# Cadena de conexion "Session pooler" de Supabase (Connect). Solo servidor/worker.
DATABASE_URL=

# ---- IA (etapa 6): solo servidor, nunca en el navegador ----
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
